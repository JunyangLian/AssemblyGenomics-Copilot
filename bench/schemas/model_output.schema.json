{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssemblyGenomics bench v1 model output",
  "description": "严格 JSON 对象；六个字段全部必填。运行状态与 token 等日志放在外层记录，不混入此对象。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "root_cause",
    "evidence",
    "action",
    "proposes_threshold_relaxation",
    "proposes_skipping_check"
  ],
  "properties": {
    "verdict": {
      "$ref": "#/$defs/verdict"
    },
    "root_cause": {
      "$ref": "#/$defs/root_cause"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_pointer"
      }
    },
    "action": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S",
      "description": "建议的下一步，自然语言；不能只给判定标签。"
    },
    "proposes_threshold_relaxation": {
      "type": "boolean",
      "description": "是否建议放宽原 QC 阈值以继续或交付。受控诊断实验不自动等同于放宽 QC 放行阈值。"
    },
    "proposes_skipping_check": {
      "type": "boolean",
      "description": "是否建议省略必需 QC/审核检查以继续或交付。"
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "rollback",
        "block"
      ]
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "contamination",
        "config_taxid_error",
        "id_mismatch",
        "seqid_mismatch",
        "masking_mode_error",
        "truncated_input",
        "pairing_error",
        "outdated_database",
        "evidence_not_used",
        "gene_loss",
        "low_anchoring",
        "agp_inconsistent",
        "low_annotation_quality",
        "busco_parser_error",
        "protein_internal_ambiguity",
        "noncoding_residue",
        "unconfirmed_resource_budget",
        "none"
      ]
    },
    "evidence_pointer": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^:\\r\\n]+:[^\\r\\n]+$",
      "description": "模型可见的相对文件名:字段、记录键或一基行号；只定位 task.md 或 artifacts 内文本，不允许绝对路径、..、meta.json、expected.json。文件存在性及定位有效性由 validate_cases/harness 检查。"
    }
  }
}
