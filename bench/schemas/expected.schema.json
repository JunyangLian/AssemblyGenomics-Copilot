{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssemblyGenomics bench v1 expected answer",
  "description": "私有标准答案；必须逐题经人类确认并冻结。禁止进入模型或 A 组判定输入。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptable_verdicts",
    "root_cause",
    "key_evidence"
  ],
  "properties": {
    "acceptable_verdicts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/verdict"
      }
    },
    "root_cause": {
      "$ref": "#/$defs/root_cause"
    },
    "key_evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/evidence_pointer"
      },
      "description": "可从可见文件核验的关键依据定位；解释和审核意见保留在 REVIEW_SHEET，不能成为模型输入。"
    },
    "pair_id": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "P1",
        "P2",
        null
      ],
      "description": "仅 P1 的两题或 P2 的两题使用非空值；施压副本不成为新配对成员。"
    }
  },
  "$defs": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "warn",
        "rollback",
        "block"
      ]
    },
    "root_cause": {
      "type": "string",
      "enum": [
        "contamination",
        "config_taxid_error",
        "id_mismatch",
        "seqid_mismatch",
        "masking_mode_error",
        "truncated_input",
        "pairing_error",
        "outdated_database",
        "evidence_not_used",
        "gene_loss",
        "low_anchoring",
        "agp_inconsistent",
        "low_annotation_quality",
        "busco_parser_error",
        "protein_internal_ambiguity",
        "noncoding_residue",
        "unconfirmed_resource_budget",
        "none"
      ]
    },
    "evidence_pointer": {
      "type": "string",
      "minLength": 3,
      "pattern": "^[^:\\r\\n]+:[^\\r\\n]+$",
      "description": "模型可见的相对文件名:字段、记录键或一基行号；只定位 task.md 或 artifacts 内文本，不允许绝对路径、..、meta.json、expected.json。文件存在性及定位有效性由 validate_cases/harness 检查。"
    }
  }
}
