{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "properties": {
          "pitfall_id": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "seen_or_heldout": {
            "const": "seen"
          }
        },
        "required": [
          "seen_or_heldout"
        ]
      },
      "then": {
        "properties": {
          "exposure_evidence": {
            "minItems": 1
          },
          "pitfall_id": {
            "enum": [
              "PIT-001",
              "PIT-002",
              "PIT-003",
              "PIT-004",
              "PIT-005",
              "PIT-006",
              "PIT-007",
              "PIT-008",
              "PIT-009",
              "PIT-010"
            ],
            "type": "string"
          }
        }
      }
    },
    {
      "else": {
        "properties": {
          "pressure_parent_case_id": {
            "type": "null"
          }
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "pressure"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "injection_script": {
            "type": "string"
          },
          "pair_id": {
            "type": "null"
          },
          "pressure_parent_case_id": {
            "pattern": "^new_0(?:17|20)$",
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "fault"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "properties": {
          "injection_script": {
            "type": "string"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "hard_negative"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "required": [
          "publication_sources",
          "own_run"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "pair_id": {
            "enum": [
              "P3"
            ]
          }
        },
        "required": [
          "pair_id"
        ]
      },
      "then": {
        "properties": {
          "type": {
            "const": "fault"
          }
        }
      }
    }
  ],
  "description": "私有溯源与分层元数据。schema 检查字段，来源真实性、文件哈希、配对相等及跨文件一致性另由验证器检查。",
  "properties": {
    "benchmark_version": {
      "const": "v2"
    },
    "case_id": {
      "pattern": "^new_0(?:1[7-9]|2[0-4])$",
      "type": "string"
    },
    "exposure_evidence": {
      "description": "原知识文件及位置、C 知识包位置，或未暴露的检查范围；仅私有记录。",
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "extractions": {
      "description": "覆盖每个可见 artifact；SHA-256 为注入/截取后的文件自身哈希。task.md 哈希在冻结清单单独记录。",
      "items": {
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "text_origin": {
                  "const": "tool_verbatim"
                }
              },
              "required": [
                "text_origin"
              ]
            },
            "then": {
              "required": [
                "verbatim_selection"
              ]
            }
          }
        ],
        "properties": {
          "artifact_path": {
            "description": "相对题目目录的模型可见产物路径。路径规范化与无符号链接越界由验证器检查。",
            "pattern": "^artifacts/(?!\\.\\.?(/|$))(?!.*\\/\\.\\.?(/|$))[^:\\\\\\r\\n]+$",
            "type": "string"
          },
          "content_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "method": {
            "enum": [
              "whole_file",
              "line_ranges",
              "byte_ranges",
              "fasta_records",
              "fastq_records",
              "feature_subset",
              "derived_summary"
            ],
            "type": "string"
          },
          "selection": {
            "description": "精确记录选择条件、记录 ID、行/字节范围及坐标约定；说明重算统计、格式变换和标准工具诊断方法。",
            "minLength": 1,
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "source_paths": {
            "items": {
              "description": "实际解析后的绝对路径；不得使用 ~、环境变量或省略号。服务器路径使用 /home/... 形式。",
              "minLength": 2,
              "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
              "type": "string"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          },
          "text_origin": {
            "description": "混合文件需拆分或逐区域记录；不是豁免整份人写文本的标签。",
            "enum": [
              "tool_verbatim",
              "human_authored",
              "derived"
            ]
          },
          "verbatim_selection": {
            "description": "源文件行/字节区域以及仅换行规范化说明；仅 tool_verbatim 使用。",
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "artifact_path",
          "source_paths",
          "method",
          "selection",
          "content_sha256",
          "size_bytes",
          "text_origin"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "injection_script": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^bench/v2/inject/[a-z_]+\\.py$",
          "type": "string"
        }
      ],
      "description": "故障/施压构造脚本；无故障注入的正常题和 hard_negative 可为 null。截取方法另记 extractions。"
    },
    "input_budget": {
      "additionalProperties": false,
      "description": "仅 task.md 加 artifacts 的可见文本预算；系统提示/schema/C 知识包另行统计，不能隐藏 C 组长度差异。",
      "properties": {
        "estimated_tokens": {
          "maximum": 30000,
          "minimum": 0,
          "type": "integer"
        },
        "estimator": {
          "description": "固定版本的 tokenizer 或保守估算方法。",
          "minLength": 1,
          "type": "string"
        },
        "limit_tokens": {
          "const": 30000
        }
      },
      "required": [
        "estimator",
        "estimated_tokens",
        "limit_tokens"
      ],
      "type": "object"
    },
    "legacy_case_number": {
      "description": "私有旧编号，仅用于迁移审核。",
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
    },
    "lexical_exceptions": {
      "description": "仅工具原样输出的单词枚举例外；大小写变体归规范 token。禁下划线枚举例外。",
      "items": {
        "additionalProperties": false,
        "properties": {
          "artifact_path": {
            "description": "相对题目目录的模型可见产物路径。路径规范化与无符号链接越界由验证器检查。",
            "pattern": "^artifacts/(?!\\.\\.?(/|$))(?!.*\\/\\.\\.?(/|$))[^:\\\\\\r\\n]+$",
            "type": "string"
          },
          "justification": {
            "minLength": 1,
            "type": "string"
          },
          "locator": {
            "minLength": 1,
            "type": "string"
          },
          "source_path": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
            "type": "string"
          },
          "source_sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "token": {
            "enum": [
              "none",
              "contamination"
            ]
          },
          "tool": {
            "minLength": 1,
            "type": "string"
          },
          "tool_version": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "token",
          "artifact_path",
          "locator",
          "source_path",
          "source_sha256",
          "tool",
          "tool_version",
          "justification"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "own_run": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "command": {
                "type": "array"
              }
            }
          },
          "if": {
            "properties": {
              "command_status": {
                "const": "not_recorded"
              }
            },
            "required": [
              "command_status"
            ]
          },
          "then": {
            "properties": {
              "command": {
                "type": "null"
              }
            },
            "required": [
              "command_missing_reason"
            ]
          }
        }
      ],
      "description": "既有 T1 用户实际运行记录；原 provenance/日志未记录命令时显式标 not_recorded 并说明，不推测、不为补字段重跑。输入/输出哈希和工具版本仍须核对。",
      "properties": {
        "command": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "type": [
            "array",
            "null"
          ]
        },
        "command_missing_reason": {
          "minLength": 1,
          "type": "string"
        },
        "command_status": {
          "enum": [
            "recorded",
            "not_recorded"
          ]
        },
        "input_sha256": {
          "items": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "minItems": 1,
          "type": "array"
        },
        "lineage": {
          "minLength": 1,
          "type": "string"
        },
        "lineage_manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "output_source_paths": {
          "items": {
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
            "type": "string"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "run_record_path": {
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
          "type": "string"
        },
        "run_record_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "runner": {
          "const": "user"
        },
        "tool_versions": {
          "additionalProperties": {
            "minLength": 1,
            "type": "string"
          },
          "minProperties": 1,
          "type": "object"
        }
      },
      "required": [
        "runner",
        "command",
        "tool_versions",
        "input_sha256",
        "output_source_paths",
        "run_record_path",
        "run_record_sha256",
        "command_status"
      ],
      "type": "object"
    },
    "pair_id": {
      "enum": [
        "P3",
        "P4",
        "P5",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "pitfall_id": {
      "enum": [
        "PIT-001",
        "PIT-002",
        "PIT-003",
        "PIT-004",
        "PIT-005",
        "PIT-006",
        "PIT-007",
        "PIT-008",
        "PIT-009",
        "PIT-010",
        null
      ],
      "type": [
        "string",
        "null"
      ]
    },
    "pressure_parent_case_id": {
      "pattern": "^new_0(?:17|20)$",
      "type": [
        "string",
        "null"
      ]
    },
    "publication_sources": {
      "description": "仅作为正常范围与标准答案依据；可见数值必须来自用户真实运行，不得抄成工具输出。",
      "items": {
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "doi"
            ]
          },
          {
            "required": [
              "url"
            ]
          }
        ],
        "properties": {
          "citation": {
            "minLength": 1,
            "type": "string"
          },
          "doi": {
            "pattern": "^10\\.\\d{4,9}/\\S+$",
            "type": "string"
          },
          "locator": {
            "description": "论文表格、图、正文段或补充材料精确位置。",
            "minLength": 1,
            "type": "string"
          },
          "reported_values": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "context": {
                  "description": "例如物种/倍性、BUSCO 模式及 lineage、重复统计口径。",
                  "minLength": 1,
                  "type": "string"
                },
                "metric": {
                  "minLength": 1,
                  "type": "string"
                },
                "unit": {
                  "minLength": 1,
                  "type": "string"
                },
                "value": {
                  "type": [
                    "number",
                    "string"
                  ]
                }
              },
              "required": [
                "metric",
                "value",
                "unit",
                "context"
              ],
              "type": "object"
            },
            "minItems": 1,
            "type": "array"
          },
          "url": {
            "format": "uri",
            "pattern": "^https?://",
            "type": "string"
          }
        },
        "required": [
          "citation",
          "locator",
          "reported_values"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "related_pitfall_ids": {
      "items": {
        "enum": [
          "PIT-001",
          "PIT-002",
          "PIT-003",
          "PIT-004",
          "PIT-005",
          "PIT-006",
          "PIT-007",
          "PIT-008",
          "PIT-009",
          "PIT-010"
        ],
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "seed": {
      "description": "确定性种子；未用随机数仍显式记录 0。",
      "maximum": 4294967295,
      "minimum": 0,
      "type": "integer"
    },
    "seen_or_heldout": {
      "description": "轴一：实际陷阱库机制是否已见；不能表达模型预训练是否见过。",
      "enum": [
        "seen",
        "held-out"
      ],
      "type": "string"
    },
    "skill_exposure": {
      "description": "轴二：冻结的 C 知识包是否明确暴露该判定规则，或仅提供相关指导。",
      "enum": [
        "explicit_rule",
        "related_guidance",
        "not_exposed"
      ],
      "type": "string"
    },
    "source_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "cohort": {
            "description": "仅允许已验证的 T1 三物种及 T3 来源；文献只作为正常范围依据。",
            "enum": [
              "T1_arabidopsis",
              "T1_celegans",
              "T1_yeast",
              "T3"
            ]
          },
          "origin_url": {
            "format": "uri",
            "pattern": "^https?://",
            "type": "string"
          },
          "path": {
            "description": "实际解析后的绝对路径；不得使用 ~、环境变量或省略号。服务器路径使用 /home/... 形式。",
            "minLength": 2,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
            "type": "string"
          },
          "preparation_record_sha256": {
            "description": "服务器准备记录/本地验收记录哈希，绑定原产物与子集的选择。",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "provenance_sha256": {
            "description": "如有，指绑定该输入/输出的 provenance 文件自身 SHA-256；不能替代源文件哈希。",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "remote_accession": {
            "minLength": 1,
            "type": "string"
          },
          "role": {
            "description": "该原始文件的用途；仅存在于私有元数据。",
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "source_kind": {
            "enum": [
              "analysis_artifact",
              "reference_assembly",
              "published_data",
              "prepared_subset"
            ],
            "type": "string"
          },
          "source_origin": {
            "description": "实际解析后的绝对路径；不得使用 ~、环境变量或省略号。服务器路径使用 /home/... 形式。",
            "minLength": 2,
            "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
            "type": "string"
          },
          "source_origin_sha256": {
            "description": "完整原产物哈希；准备包只含子集时不得与本地子集 sha256 混淆。",
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "source_origin",
          "sha256",
          "size_bytes",
          "role",
          "cohort"
        ],
        "type": "object"
      },
      "minItems": 1,
      "type": "array"
    },
    "source_scope": {
      "const": "T1_T3"
    },
    "source_snapshot": {
      "additionalProperties": false,
      "properties": {
        "manifest_path": {
          "description": "实际解析后的绝对路径；不得使用 ~、环境变量或省略号。服务器路径使用 /home/... 形式。",
          "minLength": 2,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
          "type": "string"
        },
        "manifest_sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "root": {
          "description": "实际解析后的绝对路径；不得使用 ~、环境变量或省略号。服务器路径使用 /home/... 形式。",
          "minLength": 2,
          "pattern": "^(?:/|[A-Za-z]:[\\\\/])",
          "type": "string"
        }
      },
      "required": [
        "root",
        "manifest_path",
        "manifest_sha256"
      ],
      "type": "object"
    },
    "spec_version": {
      "const": "2.0"
    },
    "stage": {
      "enum": [
        "input",
        "assembly",
        "hic",
        "scaffolding",
        "repeat_annotation",
        "structural_annotation",
        "functional_annotation"
      ],
      "type": "string"
    },
    "synthetic": {
      "description": "构造格式/一致性故障或小子集时为 true；不免除真实来源及 SHA-256 义务，也不等同于可凭空生成读段。",
      "type": "boolean"
    },
    "type": {
      "enum": [
        "fault",
        "normal",
        "hard_negative",
        "pressure"
      ],
      "type": "string"
    }
  },
  "required": [
    "benchmark_version",
    "case_id",
    "stage",
    "type",
    "seen_or_heldout",
    "skill_exposure",
    "exposure_evidence",
    "pitfall_id",
    "source_files",
    "injection_script",
    "seed",
    "synthetic",
    "pair_id",
    "pressure_parent_case_id",
    "source_snapshot",
    "extractions",
    "input_budget",
    "spec_version",
    "source_scope"
  ],
  "title": "AssemblyGenomics bench v2 case metadata",
  "type": "object"
}
